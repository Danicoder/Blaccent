# Variables públicas de cliente (expuestas en el navegador). Copia este archivo a .env y rellena los valores.
# Nunca pongas aquí claves privilegiadas (service_role) ni valores reales.

# URL base del proyecto Supabase (Project Settings > API), sin /rest/v1/
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Clave pública (publishable / anon) del proyecto
VITE_SUPABASE_ANON_KEY=your-publishable-key
# Dominio de correo permitido para acceder
VITE_ALLOWED_EMAIL_DOMAIN=accenture.com
# Coordenadas de la sede de Panoramis (destino predeterminado)
VITE_PANORAMIS_LAT=38.3418
VITE_PANORAMIS_LNG=-0.4831
